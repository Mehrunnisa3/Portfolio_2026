---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkIndexRow from '../components/WorkIndexRow.astro';
import PaperRow from '../components/PaperRow.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const papers = await getCollection('papers');

const credentials = [
  'MSc Interactive Arts & Technology, SFU',
  '3 papers published',
  'CAAD Futures · HCII  · AHFE',
  'Surrey, BC',
];

const filters = [
  { id: 'f-all', label: 'All' },
  { id: 'f-work', label: 'Case Studies' },
  { id: 'f-research', label: 'Research' },
];
---

<Base
  title="Mehrun-Nisa Raja — UX Researcher & Interaction Designer"
  description="UX researcher and interaction designer studying why people engage, then designing so they do. Selected case studies and published research."
>
  <!-- Hero -->
  <section
    class="relative flex min-h-[90svh] flex-col justify-center overflow-hidden px-6 pt-44 pb-12 md:px-14"
  >
    <div class="relative mx-auto w-full max-w-[1400px]">
      <p class="label relative z-20 mb-8 !text-ink/45 md:mb-10">
        UX Researcher &amp; Interaction Designer &mdash; Surrey, BC
      </p>

      <div class="relative">
        <!--
          The figurine video sits behind both text tiers, sized via
          aspect-ratio before it loads so nothing shifts once it decodes its
          first frame. No controls, no UI chrome — it reads as part of the
          page, not an embedded player.

          mix-blend-mode: multiply dissolves the video's near-white backdrop
          into --color-paper, and the radial-gradient mask fades the whole
          box to transparent at its edges. The mask is the one that actually
          matters: relying on multiply's colour math alone still left a
          visible rectangle, because video compression means the backdrop is
          never perfectly flat pixel-to-pixel. A soft fade hides that
          regardless of how close the colours actually match.
        -->
        <div
          class="pointer-events-none absolute top-[58%] right-[-9vw] z-0 aspect-[1244/1664] w-[80vw] max-w-[500px] -translate-y-1/2 opacity-90 sm:right-[-6vw] sm:w-[56vw] lg:right-[-5vw] lg:w-[36vw]"
          style="mask-image: radial-gradient(ellipse 62% 58% at 50% 48%, black 55%, transparent 92%); -webkit-mask-image: radial-gradient(ellipse 62% 58% at 50% 48%, black 55%, transparent 92%);"
        >
          <video
            data-autoplay-video
            src="/media/home-figurine.mp4"
            autoplay
            loop
            muted
            playsinline
            disablepictureinpicture
            preload="auto"
            class="mix-blend-multiply size-full object-contain"
          ></video>
        </div>

        <h1 class="relative z-20">
          <span class="block max-w-[20ch] font-display text-[clamp(3.5rem,10vw,8.5rem)] leading-[0.95] tracking-tight">
            I&rsquo;m <span
              class="mark-swipe"
              style="--swipe-top: 0.6em; --swipe-h: 0.3em;"
            >Mehrun-Nisa</span>,
          </span>
          <span class="mt-2 block max-w-[30ch] font-display text-display">
            a UX researcher &amp; interaction designer who studies why people
            <em class="italic">engage</em> &mdash; then designs so they do.
          </span>
        </h1>
      </div>
    </div>
  </section>

  <script>
    // Autoplaying video is motion some visitors have asked their OS to
    // suppress — honour it by freezing every such clip on its first frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document
        .querySelectorAll<HTMLVideoElement>('video[data-autoplay-video]')
        .forEach((video) => {
          video.removeAttribute('autoplay');
          video.pause();
        });
    }
  </script>

  <!-- Name + credentials: doubles as the hero's closing rule. -->
  <div class="px-6 md:px-14">
    <div
      class="mx-auto flex max-w-[1400px] flex-wrap items-baseline gap-x-9 gap-y-3 border-y border-rule py-5"
    >
      <p class="font-serif-text text-xl font-light">Mehrun-Nisa Raja</p>
      <ul class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
        {
          credentials.map((item) => (
            <li class="label !text-[11px] !text-ink/55">{item}</li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Index -->
  <section id="work" class="px-6 pt-20 pb-24 md:px-14 md:pt-28">
    <div class="index mx-auto max-w-[1400px]">
      <fieldset>
        <legend class="sr-only">Filter the index</legend>
        {
          filters.map((filter, i) => (
            <input
              type="radio"
              name="index-filter"
              id={filter.id}
              class="sr-only"
              checked={i === 0}
            />
          ))
        }

        <div class="tabs mb-16 flex flex-wrap items-center gap-2">
          {
            filters.map((filter) => (
              <label
                for={filter.id}
                class="label cursor-pointer rounded-full border border-rule px-4 py-2 !text-[11px] transition duration-250 hover:border-ink/40 hover:!text-ink"
              >
                {filter.label}
              </label>
            ))
          }
        </div>

        <div class="groups">
          <div data-group="work">
            <h2 class="label mb-10 !text-ink/45">Selected work</h2>
            <div class="grid grid-cols-1 gap-x-12 gap-y-20 md:grid-cols-2">
              {
                projects.map((project, i) => (
                  <WorkIndexRow
                    href={`/work/${project.id}`}
                    index={String(i + 1).padStart(2, '0')}
                    title={project.data.title}
                    oneLiner={project.data.oneLiner}
                    disciplines={project.data.disciplines}
                    sector={project.data.sector}
                    image={project.data.indexImage}
                    alt={`${project.data.title} — ${project.data.oneLiner}`}
                  />
                ))
              }
            </div>
          </div>

          <div data-group="research" id="research" class="mt-24 scroll-mt-28">
            <div
              class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_280px] md:items-start md:gap-16 lg:grid-cols-[1fr_320px] lg:gap-24"
            >
              <div>
                <h2 class="label mb-4 !text-ink/45">Research</h2>
                <p class="mb-6 max-w-[24ch] font-display text-[clamp(2rem,3.6vw,3rem)] font-normal leading-[1.05] tracking-tight text-ink">
                  Yes, I have published three papers, here check them out.
                </p>
                <ul class="border-b border-rule">
                  {papers.map((paper) => <PaperRow {...paper.data} />)}
                </ul>
              </div>

              <!--
                Emphasised rather than a small corner badge — this is the same
                figurine as the hero, close-up, framed like a poster. object-cover
                within an aspect-ratio box keeps it from shifting the layout as it
                loads. mix-blend-mode: multiply dissolves the video's own
                near-white backdrop into --color-paper, same technique as the
                hero figurine, so the panel doesn't read as a separate white box
                sitting on the page — no ring here, a hard border would undo that.
              -->
              <div
                class="relative mx-auto aspect-[716/1284] w-full max-w-[260px] overflow-hidden rounded-sm bg-paper md:mx-0 lg:max-w-[320px]"
              >
                <video
                  data-autoplay-video
                  src="/media/papers-closeup.mp4"
                  autoplay
                  loop
                  muted
                  playsinline
                  disablepictureinpicture
                  preload="auto"
                  class="mix-blend-multiply size-full object-cover"
                ></video>
              </div>
            </div>
          </div>
        </div>
      </fieldset>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-28 px-6 py-24 md:px-14 md:py-32">
    <div class="mx-auto max-w-[900px]">
      <p class="label mb-8 !text-ink/45">About</p>
      <p class="reveal font-serif-text text-lede font-light text-ink/90">
        I&rsquo;m a UX researcher and interaction designer focused on engagement
        &mdash; understanding the behaviours and motivations behind why people act,
        then translating that into interfaces that earn attention honestly.
      </p>
    </div>
  </section>
</Base>

<style>
  /* CSS-only filtering — the radios precede .groups, so sibling selectors do the work. */
  #f-work:checked ~ .groups [data-group='research'],
  #f-research:checked ~ .groups [data-group='work'] {
    display: none;
  }

  /* When only research shows, drop its top margin so it doesn't float. */
  #f-research:checked ~ .groups [data-group='research'] {
    margin-top: 0;
  }

  #f-all:checked ~ .tabs label[for='f-all'],
  #f-work:checked ~ .tabs label[for='f-work'],
  #f-research:checked ~ .tabs label[for='f-research'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper) !important;
  }

  /* Keyboard focus on the visually hidden radio must surface on its label. */
  #f-all:focus-visible ~ .tabs label[for='f-all'],
  #f-work:focus-visible ~ .tabs label[for='f-work'],
  #f-research:focus-visible ~ .tabs label[for='f-research'] {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
</style>
