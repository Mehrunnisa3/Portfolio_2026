---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** bleed pushes the figure past the 1000px prose column for visual set-pieces. */
  bleed?: boolean;
  frame?: boolean;
  /**
   * Cap the rendered width in px. Low-resolution diagram exports go blurry and
   * unreadable when stretched to fill the column — never display above native.
   */
  maxWidth?: number;
  /** Open full-resolution in the lightbox on click. For detail-heavy diagrams. */
  zoom?: boolean;
}

const { src, alt, caption, bleed = false, frame = true, maxWidth, zoom = false } =
  Astro.props;

// Cap the zoom render at 2400px: beyond that the file cost outweighs any legibility
// gain, and most sources here are smaller anyway.
const full = zoom
  ? await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' })
  : undefined;
---

<figure
  class:list={[
    'reveal my-14',
    bleed && 'lg:-mx-[max(0px,calc((100vw-1400px)/2+3.5rem))]',
  ]}
>
  <div
    class:list={[
      'overflow-hidden bg-rule/25',
      frame && 'rounded-sm ring-1 ring-ink/10',
      maxWidth && 'mx-auto',
    ]}
    style={maxWidth ? `max-width: ${maxWidth}px` : undefined}
  >
    {
      full ? (
        <a
          href={full.src}
          data-zoom
          data-zoom-src={full.src}
          data-zoom-alt={alt}
          data-zoom-caption={caption ?? alt}
          class="group/zoom relative block cursor-zoom-in"
        >
          <Image
            src={src}
            alt={alt}
            widths={[700, 1100, 1600]}
            sizes={bleed ? '(min-width: 1024px) 90vw, 92vw' : '(min-width: 1024px) 1000px, 92vw'}
            class="block h-auto w-full object-contain"
          />
          <span class="label pointer-events-none absolute right-3 bottom-3 rounded-full bg-void/80 px-3 py-1.5 !text-[10px] !text-bone opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover/zoom:opacity-100">
            Click to enlarge
          </span>
        </a>
      ) : (
        <Image
          src={src}
          alt={alt}
          widths={[700, 1100, 1600]}
          sizes={bleed ? '(min-width: 1024px) 90vw, 92vw' : '(min-width: 1024px) 1000px, 92vw'}
          class="block h-auto w-full object-contain"
        />
      )
    }
  </div>
  {
    caption && (
      <figcaption class="label mt-4 !text-[11px] !normal-case !tracking-wide !text-ink/55">
        {caption}
      </figcaption>
    )
  }
</figure>
