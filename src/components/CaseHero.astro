---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle: string;
  role: string;
  duration: string;
  readTime: string;
  year: string;
  image: ImageMetadata;
  video?: string;
}

const { title, subtitle, role, duration, readTime, year, image, video } =
  Astro.props;

const meta = [
  { label: 'Role', value: role },
  { label: 'Duration', value: duration },
  { label: 'Read time', value: readTime },
  { label: 'Year', value: year },
];
---

<section
  data-dark-stage
  class="relative flex min-h-svh flex-col justify-between overflow-hidden bg-void px-6 pt-32 pb-10 text-bone md:px-14 md:pt-40"
>
  <div
    class="mx-auto grid w-full max-w-[1400px] flex-1 grid-cols-1 items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20"
  >
    <div>
      <h1
        class="font-display text-[clamp(2.75rem,6.5vw,5.5rem)] font-light leading-[1.02] tracking-tight"
      >
        {title}
      </h1>
      <p class="mt-8 max-w-[46ch] text-[clamp(1.0625rem,1.5vw,1.3125rem)] leading-relaxed text-bone/70">
        {subtitle}
      </p>
    </div>

    <!--
      Assets top out at 2760px wide (Line Up) and 1600px (D-GAM), and the hero
      videos are 500x500 / 830x720. Presenting them at native aspect inside a
      framed stage keeps them sharp; stretching them edge-to-edge would not.
    -->
    <figure class="relative">
      <div
        class="relative overflow-hidden rounded-sm bg-bone/5 ring-1 ring-bone/10"
      >
        {
          video ? (
            <video
              src={video}
              poster={image.src}
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              class="block max-h-[58svh] w-full object-contain"
            />
          ) : (
            <Image
              src={image}
              alt={`${title} — project hero`}
              widths={[700, 1100, 1600]}
              sizes="(min-width: 1024px) 46vw, 92vw"
              class="block max-h-[58svh] w-full object-contain"
            />
          )
        }
      </div>
    </figure>
  </div>

  <dl
    class="mx-auto mt-14 grid w-full max-w-[1400px] grid-cols-2 gap-x-8 gap-y-7 border-t border-bone/12 pt-8 md:grid-cols-4"
  >
    {
      meta.map((item) => (
        <div>
          <dt class="label !text-[11px] !text-mute">{item.label}</dt>
          <dd class="mt-2 text-[15px] text-bone/90">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
