---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Contact sheet of app screens, each openable at full resolution — at grid size the
 * UI text is only legible in the lightbox.
 *
 * Deliberately not bled past the prose column: the caption would then run under the
 * section-index rail in the left gutter. Deliberately not staggered either — the
 * screens share a uniform aspect, so an even grid aligns cleanly, and offsetting
 * alternate items only made the rows ragged.
 */
interface Item {
  src: ImageMetadata;
  alt: string;
  /** Short caption rendered under the screen, e.g. "Project selection". */
  label?: string;
}

interface Props {
  items: Item[];
  /** Pick a column count that divides the item count, so rows come out even. */
  columns?: 4 | 5;
  /**
   * Which shape the source art already has — checked by sampling corner alpha:
   *
   *  'alpha' — corners are transparent, so the artwork carries its own rounding.
   *            Add no background, no clip and no ring (a ring would draw a
   *            rectangle around the transparent corners). Shadow must be a
   *            `drop-shadow` filter so it follows the silhouette, not the box.
   *  'rect'  — opaque rectangle, so it needs clipping to look like a device.
   */
  shape?: 'alpha' | 'rect';
  caption?: string;
}

const { items, columns = 5, shape = 'alpha', caption } = Astro.props;

const zoomed = await Promise.all(
  items.map((i) =>
    getImage({ src: i.src, width: Math.min(i.src.width, 1400), format: 'webp' }),
  ),
);

/*
 * The sources are not all the same aspect — the redesign mockups run from 666x1405
 * to 704x1404. Filling equal-width columns therefore rendered the widest one
 * *shorter* than the rest, so it read as smaller. Each cell instead gets a fixed box
 * at the widest aspect present and the image is constrained by height, which makes
 * every phone exactly the same height (the widest is then a few px wider, which is
 * imperceptible; unequal heights were not).
 */
const boxAspect = Math.max(...items.map((i) => i.src.width / i.src.height));

const cols = {
  4: 'grid-cols-2 sm:grid-cols-4',
  5: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-5',
};
---

<figure class="reveal my-14">
  <ul class:list={['grid list-none items-start gap-3 sm:gap-4', cols[columns]]}>
    {
      items.map((item, i) => (
        <li class="flex flex-col items-center gap-2">
          <div class="flex w-full justify-center" style={`aspect-ratio: ${boxAspect}`}>
            <a
              href={zoomed[i].src}
              data-zoom
              data-zoom-src={zoomed[i].src}
              data-zoom-alt={item.alt}
              data-zoom-caption={item.alt}
              class:list={[
                'group/zoom relative block h-full cursor-zoom-in',
                shape === 'alpha'
                  ? 'screen-alpha'
                  : 'overflow-hidden rounded-[16%/7.7%] shadow-[2px_4px_12px_rgba(22,21,15,0.16)] transition-shadow duration-300 hover:shadow-[2px_6px_18px_rgba(22,21,15,0.24)]',
              ]}
            >
              <Image
                src={item.src}
                alt={item.alt}
                widths={[260, 480, 760]}
                sizes="(min-width: 1024px) 18vw, 45vw"
                class="block h-full w-auto object-contain"
              />
            </a>
          </div>
          {
            item.label && (
              <span class="label text-center !text-[10px] !tracking-wide !text-ink/55">
                {item.label}
              </span>
            )
          }
        </li>
      ))
    }
  </ul>
  {
    caption && (
      <figcaption class="label mt-5 !text-[11px] !normal-case !tracking-wide !text-ink/55">
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  /*
   * drop-shadow, not box-shadow: these sources have transparent rounded corners, so
   * a box-shadow would trace a rectangle outside the artwork. The filter follows the
   * alpha silhouette instead. No background or ring for the same reason.
   */
  .screen-alpha img {
    filter: drop-shadow(1px 3px 6px rgb(22 21 15 / 0.14));
    transition: filter 0.3s ease;
  }

  .screen-alpha:hover img {
    filter: drop-shadow(1px 5px 12px rgb(22 21 15 / 0.22));
  }
</style>
