---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  index: string;
  title: string;
  oneLiner: string;
  disciplines: string[];
  sector: string;
  image: ImageMetadata;
  alt: string;
}

const { href, index, title, oneLiner, disciplines, sector, image, alt } = Astro.props;
---

<article class="reveal work-row border-b border-rule" data-kind="project">
  <a href={href} class="work-row__link block">
    <div class="work-row__left">
      <span class="work-row__index font-mono text-[13px] text-ink/35">{index}</span>
      <div class="min-w-0">
        <h3 class="work-row__title font-display text-[clamp(2.75rem,6vw,5.5rem)] font-normal leading-[0.98] tracking-tight">
          {title}
        </h3>
        <p class="label mt-2.5 !text-[11px] !text-ink/45">
          {disciplines.join(' · ')} <span class="text-rose">· {sector}</span>
        </p>
        <p class="mt-4 max-w-[46ch] text-[17px] leading-relaxed text-ink/70">
          {oneLiner}
        </p>
      </div>
    </div>

    <span class="work-row__ghost label !text-[10px] !text-ink/40" aria-hidden="true">
      View<br />Project
    </span>

    <div class="work-row__media">
      <Image
        src={image}
        alt={alt}
        widths={[460, 700, 920]}
        sizes="(min-width: 860px) 36vw, 92vw"
        class="size-full object-cover"
      />
    </div>

    <span class="work-row__cta label !text-[11px] !text-paper" aria-hidden="true">
      View Project &rarr;
    </span>
  </a>
</article>

<style>
  .work-row__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3.5rem;
  }

  .work-row__left {
    display: flex;
    align-items: baseline;
    gap: 1.75rem;
    min-width: 0;
  }

  .work-row__index {
    flex: none;
  }

  .work-row__title {
    transition: transform 0.5s var(--ease-out-expo);
  }
  .work-row:hover .work-row__title {
    transform: translateX(0.5rem);
  }

  .work-row__ghost {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    text-align: center;
    line-height: 1.3;
    transition: opacity 0.3s ease;
  }
  .work-row:hover .work-row__ghost {
    opacity: 0;
  }

  .work-row__media {
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 50%;
    width: min(36vw, 460px);
    aspect-ratio: 16 / 10;
    transform: translateY(-50%) translateX(3rem) rotate(2deg);
    opacity: 0;
    z-index: 5;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    box-shadow: 0 30px 60px -20px rgba(22, 21, 15, 0.25);
    transition:
      transform 0.55s var(--ease-out-expo),
      opacity 0.4s ease;
  }
  .work-row:hover .work-row__media {
    transform: translateY(-50%) translateX(0) rotate(0deg);
    opacity: 1;
  }
  .work-row__media :global(img) {
    display: block;
  }

  .work-row__cta {
    position: absolute;
    right: calc(min(36vw, 460px) / 2);
    top: 50%;
    transform: translate(50%, -50%) translateY(1rem);
    z-index: 6;
    display: inline-flex;
    align-items: center;
    background: var(--color-ink);
    border-radius: 999px;
    padding: 1rem 1.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 16px 32px -12px rgba(22, 21, 15, 0.35);
    transition:
      transform 0.45s var(--ease-out-expo) 0.05s,
      opacity 0.35s ease 0.05s;
  }
  .work-row:hover .work-row__cta {
    opacity: 1;
    transform: translate(50%, -50%) translateY(0);
  }

  @media (max-width: 860px) {
    .work-row__link {
      flex-direction: column;
      align-items: flex-start;
    }
    .work-row__media {
      position: static;
      width: 100%;
      transform: none;
      opacity: 1;
      margin-top: 1.5rem;
      box-shadow: none;
    }
    .work-row__cta {
      position: static;
      transform: none;
      opacity: 1;
      margin: -2.5rem auto 0;
      display: flex;
      width: fit-content;
    }
    .work-row__ghost {
      display: none;
    }
  }
</style>
