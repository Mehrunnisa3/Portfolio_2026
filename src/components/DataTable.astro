---
/**
 * Research tables as markup rather than screenshots. The originals were Word
 * captures, which meant baked-in spellcheck squiggles, no text selection, no
 * screen-reader access and ~80 KB per table.
 *
 * Below `md` the table scrolls horizontally rather than reflowing: these are
 * comparison matrices, and collapsing them into stacked cards destroys the
 * row-to-row comparison that is the whole point.
 */
interface Props {
  columns: string[];
  rows: string[][];
  caption?: string;
  /** Index of the column that should read as the row's label. */
  labelColumn?: number;
  /** Column whose repeated values get a categorical colour dot. */
  accentColumn?: number;
  /** Value → hex. Only recurring values need a hue; the rest stay neutral. */
  accentColors?: Record<string, string>;
  /** Use on a dark stage (bg-void) instead of the default paper background. */
  dark?: boolean;
}

const {
  columns,
  rows,
  caption,
  labelColumn = 0,
  accentColumn,
  accentColors = {},
  dark = false,
} = Astro.props;

const hasAccents = accentColumn !== undefined && Object.keys(accentColors).length > 0;
---

<figure class="reveal my-14">
  <div class="-mx-6 overflow-x-auto px-6 md:mx-0 md:px-0">
    <table class="w-full min-w-[46rem] border-collapse text-left">
      {caption && <caption class="sr-only">{caption}</caption>}
      <thead>
        <tr class:list={['border-b', dark ? 'border-bone/25' : 'border-ink/25']}>
          {
            columns.map((col) => (
              <th
                scope="col"
                class:list={[
                  'label px-3 py-3 !text-[10.5px] first:pl-0 last:pr-0',
                  dark ? '!text-bone/70' : '!text-ink/70',
                ]}
              >
                {col}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class:list={['align-top', dark ? 'odd:bg-bone/5' : 'odd:bg-blush/18']}>
              {row.map((cell, i) =>
                i === labelColumn ? (
                  <th
                    scope="row"
                    class:list={[
                      'px-3 py-3.5 pr-6 text-[15px] font-semibold first:pl-3',
                      dark ? 'text-bone' : 'text-ink',
                    ]}
                  >
                    {cell}
                  </th>
                ) : (
                  <td
                    class:list={[
                      'px-3 py-3.5 text-[15px] leading-snug last:pr-3',
                      dark ? 'text-bone/70' : 'text-ink/70',
                    ]}
                  >
                    {i === accentColumn && accentColors[cell] ? (
                      <span class="flex items-baseline gap-2">
                        {/*
                          The dot carries the grouping; the name stays in ink.
                          Colour is never the only cue, which also covers the
                          sub-3:1 contrast of the lighter hues on paper.
                        */}
                        <span
                          aria-hidden="true"
                          class="mt-[0.45em] size-2 flex-none rounded-full"
                          style={`background: ${accentColors[cell]}`}
                        />
                        <span>{cell}</span>
                      </span>
                    ) : (
                      cell
                    )}
                  </td>
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    hasAccents && (
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
        {Object.entries(accentColors).map(([value, hex]) => (
          <li class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="size-2 flex-none rounded-full"
              style={`background: ${hex}`}
            />
            <span class="label !text-[10.5px] !normal-case !tracking-wide">
              {value}
            </span>
          </li>
        ))}
      </ul>
    )
  }
  {
    caption && (
      <figcaption
        class:list={[
          'label mt-4 !text-[12px] !normal-case !tracking-wide',
          dark ? '!text-bone/70' : '!text-ink/70',
        ]}
      >
        {caption}
      </figcaption>
    )
  }
</figure>
