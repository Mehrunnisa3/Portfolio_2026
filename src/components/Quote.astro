---
interface Props {
  attribution?: string;
}

const { attribution } = Astro.props;
---

<figure class="reveal my-12 border-l-2 border-rose pl-6 md:pl-8">
  <blockquote
    class="font-serif-text text-[clamp(1.25rem,2.2vw,1.625rem)] leading-snug font-light italic text-ink/85"
  >
    <slot />
  </blockquote>
  {
    attribution && (
      <figcaption class="label mt-4 !text-[11px]">{attribution}</figcaption>
    )
  }
</figure>
